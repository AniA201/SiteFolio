# Copy to backend/.env and fill in. backend/.env is gitignored; never commit real keys.

# Matterport (from /costar-keys in the track Discord)
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
# Browser-safe SDK key for the live 3D tour
VITE_MATTERPORT_SDK_KEY=
# Path to models_index.csv from the quickstart notebook folder (defaults to app/data/models_index.csv)
MODELS_INDEX_CSV=

# Vexcel
VEXCEL_API_KEY=

# CoStar kit: the download link or a local zip path, plus the zip password
COSTAR_KIT_URL=
COSTAR_KIT_ZIP=
COSTAR_ZIP_PASSWORD=

# AI model and tracing
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=

# Tiger Cloud (Postgres + TimescaleDB)
TIGER_DATABASE_URL=

# Public address phones use for Try to fool it (QR code), once deployed
PUBLIC_URL=

# Free models for the deep agent (Groq free tier, then local Ollama)
GROQ_API_KEY=

# AWS Bedrock models for the agent (optional; free Groq/Ollama are the backup)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
